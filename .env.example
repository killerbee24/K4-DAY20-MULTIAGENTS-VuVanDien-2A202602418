# Copy this file to .env and fill in the values. NEVER commit .env.
# Option 1 - Azure OpenAI or an OpenAI-compatible gateway (give all three):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT_MODEL=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview   # only for real *.openai.azure.com endpoints

# Option 2 - Claude through an Anthropic-compatible gateway such as MWAPI.
# Keep Option 1 empty. Do not append /v1 to ANTHROPIC_BASE_URL because
# the Anthropic SDK appends /v1/messages itself.
# LAB_MODEL=anthropic:claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.mwapi.dev

# Option 3 - another provider (leave Option 1 empty):
# LAB_MODEL=deepseek:deepseek-chat
# DEEPSEEK_API_KEY=

LAB_TEMPERATURE=0
